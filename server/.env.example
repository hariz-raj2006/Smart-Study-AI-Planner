# ===== SERVER environment (copy this file to server/.env) =====
# These values stay on the backend. NEVER put them in the client folder.

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Check the current list of models at https://ai.google.dev/gemini-api/docs/models
# and use one your key can access. Google retires older models over time.
GEMINI_MODEL=gemini-3.8-flash

# Optional: how long to wait for Gemini before giving up (milliseconds)
GEMINI_TIMEOUT_MS=45000
PORT=5000
CLIENT_URL=http://localhost:5173

# Must be a long random string. Generate one in PowerShell with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=your_seceret_key_here

# JSON data file (created automatically on first run)
DATABASE_PATH=./database/smartstudy.json
# JSON data file (created automatically on first run)
DATABASE_PATH=./database/smartstudy.json