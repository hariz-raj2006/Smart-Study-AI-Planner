# ===== FRONTEND environment (copy this file to client/.env if you need to change anything) =====
# Everything starting with VITE_ is bundled into the browser code and is PUBLIC.
# NEVER put the Gemini API key, SESSION_SECRET or any other secret here.
# (Those belong only in server/.env.)

# Leave empty during development: the Vite dev server proxies /api to the backend.
# Set it only if the API is hosted on a different address, e.g. https://api.example.com
VITE_API_BASE_URL=http://localhost:5000/api

# Where the dev server forwards /api requests (must match PORT in server/.env).
VITE_DEV_API_TARGET=http://localhost:5000